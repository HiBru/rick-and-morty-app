<resources>
    <string name="app_name">Rick and Morty</string>

    <!-- Actions. Static labels, so they live here rather than in a UiText. -->
    <string name="action_retry">Retry</string>
    <string name="action_cancel">Cancel</string>
    <!-- Names the destructive action rather than saying OK. -->
    <string name="action_remove">Remove</string>

    <!-- Bottom navigation. The real screens reuse these as their titles. -->
    <string name="nav_home">Home</string>
    <string name="nav_favorites">Favorites</string>
    <string name="nav_settings">Settings</string>

    <!-- The detail screen's only control besides the heart. -->
    <string name="cd_navigate_back">Back</string>

    <!--
      Character status, as every row and the detail screen label it. The API's
      own words, capitalised: it sends "Alive", "Dead" and "unknown".
    -->
    <string name="status_alive">Alive</string>
    <string name="status_dead">Dead</string>
    <string name="status_unknown">Unknown</string>

    <!--
      The favourite button's description. Data-dependent — which of the two, and
      whose name goes in it — so an assembler picks it and the composable only
      resolves it.

      The name is interpolated so a list does not read as twenty identical "Add
      to favorites" buttons. The placeholder is indexed (%1$s) and must stay
      that way: Compose Resources substitutes only indexed placeholders, and a
      bare %s is emitted literally with no error.
    -->
    <string name="cd_add_favorite">Add %1$s to favorites</string>
    <string name="cd_remove_favorite">Remove %1$s from favorites</string>

    <!--
      The confirmation every removal goes through, per SPEC. Only the message is
      here: the dialog's title and its confirm label never depend on data, so
      they stay stringResource(...) at the call site.

      It names the consequence rather than restating the question the title
      already asked — losing the offline copy is the part the user cannot see
      from the button they tapped.
    -->
    <string name="favorite_remove_title">Remove favorite?</string>
    <string name="favorite_remove_message">%1$s will no longer be saved for offline viewing.</string>

    <!--
      The detail screen's field labels. Static, one per row of the field list —
      only the values are data. "Last known location" is the API's own framing:
      a character's location is where they were last seen, not where they are.
    -->
    <string name="detail_type">Type</string>
    <string name="detail_gender">Gender</string>
    <string name="detail_origin">Origin</string>
    <string name="detail_location">Last known location</string>
    <string name="detail_episodes">Episodes</string>
    <string name="detail_created">Added to the API</string>

    <!--
      Error messages, one per reachable DataError constant.

      Each says what happened and, where the user can do something, what. None
      of them name a cause the user cannot act on, and none blame the user for a
      fault that is ours.

      Apostrophes are NOT escaped here. Compose Resources is not aapt: its
      Gradle plugin unescapes only \uXXXX, \n, \t and \\, and the runtime
      returns the text verbatim — so a \' would ship a visible backslash to the
      user. For the same reason, any future placeholder must be indexed
      (%1$s, %1$d); a bare %s is emitted literally with no error.
    -->
    <string name="error_no_internet">No internet connection. Check your connection and try again.</string>
    <string name="error_request_timeout">The request took too long. Try again.</string>
    <string name="error_not_found">We couldn't find what you were looking for.</string>
    <string name="error_too_many_requests">Too many requests. Wait a moment and try again.</string>
    <string name="error_server">The server is having trouble. Try again later.</string>
    <!-- Our bug, not theirs: the response arrived but did not match what we expected. -->
    <string name="error_serialization">We couldn't read the server's response.</string>
    <string name="error_disk_full">There's no space left on your device.</string>
    <!--
      Source-neutral on purpose: DataError.Local.UNKNOWN comes from reads
      (getFavorite, and the local-first getCharacter behind the detail screen) as
      well as writes, so it must not claim a save failed.
    -->
    <string name="error_local_unknown">Something went wrong on your device. Try again.</string>
    <string name="error_unknown">Something went wrong. Try again.</string>
</resources>
